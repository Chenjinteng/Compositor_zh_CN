    "Show clipped highlights in red on the preview.": {
      "comment": "Camera Raw highlight clipping toggle tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览中以红色显示被裁剪的高光。"
          }
        }
      }
    },
    "Auto balances the average color. Custom follows Temperature and Tint.": {
      "comment": "Camera Raw white balance tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto 平均化整体色彩;Custom 按色温和色调调整。"
          }
        }
      }
    },
    "Click a pixel that should be neutral.": {
      "comment": "Camera Raw white balance eyedropper tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击应为中性的像素。"
          }
        }
      }
    },
    "Diffusion is soft and wide, Bloom is tighter, and Halation is a red fringe.": {
      "comment": "Camera Raw glow style picker tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusion 柔和宽广,Bloom 更紧凑,Halation 是红色光晕。"
          }
        }
      }
    },
    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "comment": "Camera Raw vignette style picker tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight Priority 保护亮边;Color Priority 同时降低色彩;Paint Overlay 均匀覆盖边缘。"
          }
        }
      }
    },
    "Pulls red and blue fringes apart toward the center to reduce color edging.": {
      "comment": "Camera Raw chromatic aberration toggle tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将红蓝边缘向中心分开以减弱色彩边缘。"
          }
        }
      }
    },
    "Applies generic profile strength when camera metadata is not available.": {
      "comment": "Camera Raw lens profile toggle tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机元数据不可用时,使用通用配置文件强度。"
          }
        }
      }
    },
    "Click a purple or green fringe to set its hue range.": {
      "comment": "Camera Raw defringe eyedropper tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击紫色或绿色边缘设置其色相范围。"
          }
        }
      }
    },
    "Off leaves the picture as it is. Guided straightens from lines you draw on the picture.": {
      "comment": "Camera Raw upright picker tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Off 保持原样;Guided 根据所绘参考线校正。"
          }
        }
      }
    },
    "Draw two or more lines on the preview that should be level or vertical.": {
      "comment": "Camera Raw draw-guides tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览上绘制两条或更多水平或垂直参考线。"
