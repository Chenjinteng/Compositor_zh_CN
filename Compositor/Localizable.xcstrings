    "Adjusts the bright parts of the picture. Hold Option to see clipped highlights.": {
      "comment": "Camera Raw: highlights tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面亮部。按住 Option 显示裁剪高光。"
          }
        }
      }
    },
    "Adjusts the dark parts of the picture. Hold Option to see clipped shadows.": {
      "comment": "Camera Raw: shadows tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整画面暗部。按住 Option 显示裁剪阴影。"
          }
        }
      }
    },
    "Brightens or darkens the corners to counter lens falloff.": {
      "comment": "Camera Raw: vignetting tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提亮或压暗四角以抵消镜头暗角。"
          }
        }
      }
    },
    "Brightens or darkens the whole picture, in stops of light. Hold Option to see clipped highlights.": {
      "comment": "Camera Raw: exposure tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按曝光档数整体提亮或压暗画面。按住 Option 显示裁剪高光。"
          }
        }
      }
    },
    "Adds film grain, strongest in the middle tones.": {
      "comment": "Camera Raw: grain tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒,中间调最强。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "comment": "Camera Raw: shadows tint tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向最暗色调添加绿色或洋红。"
          }
        }
      }
    },
    "Adds or softens contrast along broader shapes.": {
      "comment": "Camera Raw: clarity tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿较大形状添加或减弱对比。"
          }
        }
      }
    },
    "Adds or softens small detail.": {
      "comment": "Camera Raw: texture tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加或减弱小细节。"
          }
        }
      }
    },
    "Clears haze when raised, and adds haze when lowered.": {
      "comment": "Camera Raw: dehaze tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调高消除雾霾,调低添加雾霾。"
          }
        }
      }
    },
    "Emphasizes fine texture over broader edges.": {
      "comment": "Camera Raw: sharpening detail tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在较宽边缘上突出细微纹理。"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "comment": "Camera Raw: luma contrast tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在亮度降噪后保持局部对比。"
          }
        }
      }
    },
    "Limits sharpening to stronger edges. Hold Option to see the mask.": {
      "comment": "Camera Raw: sharpening mask tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将锐化限制在较强的边缘。按住 Option 查看蒙版。"
          }
        }
      }
    },
    "Sets how far the glow reaches. Has no effect until Glow is raised.": {
      "comment": "Camera Raw: glow range tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置光晕扩散范围。仅在 Glow 调高后生效。"
          }
        }
      }
    },
    "Sets the brightest point. Hold Option to see clipped highlights.": {
      "comment": "Camera Raw: whites tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最亮端点。按住 Option 查看裁剪高光。"
          }
        }
      }
    },
    "Sets the darkest point. Hold Option to see clipped shadows.": {
      "comment": "Camera Raw: blacks tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最暗端点。按住 Option 查看裁剪阴影。"
          }
        }
      }
    },
    "Sets where the vignette begins, from the center outward.": {
      "comment": "Camera Raw: vignette midpoint tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置暗角从中心向外的起始位置。"
          }
        }
      }
    },
    "Softens the edge of the vignette.": {
      "comment": "Camera Raw: vignette feather tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "柔化暗角的边缘。"
          }
        }
      }
    },
    "Makes the vignette rounder or more square.": {
      "comment": "Camera Raw: vignette roundness tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让暗角更圆或更方。"
          }
        }
      }
    },
    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "comment": "Camera Raw: vibrance tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对原本就较弱的颜色增强更明显,同时保护肤色。"
          }
        }
      }
    },
    "Strengthens or weakens every color by the same amount.": {
      "comment": "Camera Raw: saturation tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等比例增强或减弱所有颜色。"
          }
        }
      }
    },
    "Strengthens or weakens the blue primary.": {
      "comment": "Camera Raw: blue primary tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱蓝色原色。"
          }
        }
      }
    },
    "Strengthens or weakens the green primary.": {
      "comment": "Camera Raw: green primary tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱绿色原色。"
          }
        }
      }
    },
    "Strengthens or weakens the red primary.": {
      "comment": "Camera Raw: red primary tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增强或减弱红色原色。"
          }
        }
      }
    },
    "Spreads a glow from the bright areas.": {
      "comment": "Camera Raw: bloom tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从亮部扩散出光晕。"
          }
        }
      }
    },
    "Light blooming around the lines, like a CRT's phosphors": {
      "comment": "Camera Raw: halation tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在曲线周围像 CRT 荧光屏那样发光"
          }
        }
      }
    },
    "Break the lines into glowing beads": {
      "comment": "Camera Raw: grain style 'beads' option.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将线条打散成发光颗粒"
          }
        }
      }
    },
    "Draw the marks for the light tones on the dark color, like a glowing screen": {
      "comment": "Camera Raw: glow style 'screen' option.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在暗底上画亮调标记,像发光的屏幕"
          }
        }
      }
    },
    "Shifts how blue is interpreted.": {
      "comment": "Camera Raw: blue primary hue tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整蓝色的诠释方式。"
          }
        }
      }
    },
    "Shifts how green is interpreted.": {
      "comment": "Camera Raw: green primary hue tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整绿色的诠释方式。"
          }
        }
      }
    },
    "Shifts how red is interpreted.": {
      "comment": "Camera Raw: red primary hue tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整红色的诠释方式。"
          }
        }
      }
    },
    "Shifts the picture from blue to yellow.": {
      "comment": "Camera Raw: temperature tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将画面从蓝色偏移到黄色。"
          }
        }
      }
    },
    "Shifts the picture from green to mauve.": {
      "comment": "Camera Raw: tint tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将画面从绿色偏移到紫红色。"
          }
        }
      }
    },
    "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised.": {
      "comment": "Camera Raw: glow warmth tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将光晕从冷色偏移到暖色;Halation 保持红色。仅在 Glow 调高后生效。"
          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels.": {
      "comment": "Camera Raw: sharpening radius tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锐化从边缘向内的像素距离。"
          }
        }
      }
    },
    "Controls how strong the sharpening is.": {
      "comment": "Camera Raw: sharpening amount tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制锐化强度。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "comment": "Camera Raw: luminance detail tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在亮度降噪时保留细微纹理。"
          }
        }
      }
    },
    "Smooths grain and noise in brightness.": {
      "comment": "Camera Raw: luminance smoothing tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑亮度的颗粒和杂色。"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced.": {
      "comment": "Camera Raw: color detail tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在色彩降噪时保留彩色边缘。"
          }
        }
