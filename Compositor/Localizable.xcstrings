          }
        }
      }
    },
    "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel.": {
      "comment": "Camera Raw grading picker tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
