      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择此拾取的颜色。"
          }
        }
      }
    },
    "Dims the picture outside this color's range. It is not kept when you press OK.": {
      "comment": "Camera Raw point color: visualize range toggle tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
