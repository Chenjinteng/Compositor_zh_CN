    "Perspective allows stronger keystone. Rectilinear keeps the warp gentler.": {
      "comment": "Camera Raw projection picker tooltip.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
